# WhatsApp Assistant Configuration

# AI Provider API Keys
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Preferred AI Model (e.g., google/gemini-2.0-flash-001, deepseek/deepseek-chat, openai/gpt-4o-mini)
AI_MODEL=google/gemini-2.0-flash-001

# Trigger & Behavior Settings
COMMAND_PREFIX=!ai
WAKE_WORDS=assistant,bot,ai
AUTO_TRANSCRIBE_AUDIO=true
AUTO_REPLY_DMS=false
RESPOND_ON_TAG=true

# Pairing code method (leave empty for terminal QR code)
PAIRING_PHONE_NUMBER=

# Timezone (Default: Asia/Kolkata)
DEFAULT_TIMEZONE=Asia/Kolkata

# Google Calendar Integration (Optional - if omitted, instant 1-click calendar links are generated)
# Option A: Path to Service Account JSON key file
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
# Option B: Direct Service Account credentials in env
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=primary
